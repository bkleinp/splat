{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "develop",
        "--prefix",
        "engine/supersplat-viewer"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@splat/web",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
