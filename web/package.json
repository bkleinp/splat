{
  "name": "splat-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names engine,web \"npm --prefix ../engine/supersplat-viewer run watch\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playcanvas/supersplat-viewer": "file:../engine/supersplat-viewer",
    "playcanvas": "2.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  }
}
